# ===========================
# Database (TiDB Serverless)
# ===========================
DATABASE_URL="mysql://user:password@host:4000/basecamp_sumbing?sslaccept=strict"
DB_HOST="gateway01.ap-southeast-1.prod.aws.tidbcloud.com"
DB_PORT=4000
DB_USERNAME="your_username"
DB_PASSWORD="your_password"
DB_DATABASE="basecamp_sumbing"

# ===========================
# Authentication
# ===========================
JWT_SECRET="basecamp-sumbing-super-secret-key-change-me"

# ===========================
# Weather API
# ===========================
WEATHER_API_KEY="your_openweathermap_api_key"
WEATHER_LAT="-7.3833"
WEATHER_LON="110.0667"

# ===========================
# Email (SMTP/Nodemailer)
# ===========================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Basecamp Gunung Sumbing <noreply@basecampsumbing.id>"

# ===========================
# Payment Gateway (Midtrans)
# ===========================
PAYMENT_SERVER_KEY="your_midtrans_server_key"
PAYMENT_CLIENT_KEY="your_midtrans_client_key"
PAYMENT_SANDBOX=true

# ===========================
# Vercel Blob Storage
# ===========================
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token"

# ===========================
# App Config
# ===========================
NODE_ENV="development"
PORT=5000
VITE_API_URL="http://localhost:5000/api"
VITE_APP_NAME="Basecamp Gunung Sumbing"
